# ============================================================
# FlyWise (APIx) — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Database (Neon PostgreSQL) ---
NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Bright Data (primary collector — Google Flights Scraper API) ---
BRIGHT_DATA_API_TOKEN=your-bright-data-serp-api-token-here
BRIGHT_DATA_ACCOUNT_TOKEN=your-bright-data-account-management-token-here
BRIGHT_DATA_ZONE=your-bright-data-zone-name

# --- Scrappa (secondary collector — Google Flights JSON) ---
SCRAPPA_API_KEY=your-scrappa-api-key-here

# --- API Authentication (for the FastAPI policy endpoints) ---
API_KEY_ALLOWED_LIST=key1,key2,key3
