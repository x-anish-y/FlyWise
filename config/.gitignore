# --- Secrets ---
.env

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# --- Node / Next.js ---
node_modules/
.next/
out/

# --- Collector raw output ---
collectors/raw_output/*.json
collectors/raw_output/domestic/*.json
collectors/raw_output/international/*.json

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Misc ---
*.log
